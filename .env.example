# Frontend (Vercel > Settings > Environment Variables). The anon key is safe in the browser.
VITE_API_BASE=https://YOUR-GATEWAY.onrender.com/api
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY
# Gateway (Render env vars). The service-role key is a SECRET: never in the frontend or git.
# SUPABASE_URL=...   SUPABASE_ANON_KEY=...   SUPABASE_SERVICE_ROLE_KEY=...
